PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel_dev
PGUSER=app_user
PGPASSWORD=app_user_pw
JWT_SECRET=change-me-in-production

# Transactional email (signup/login codes, booking confirmations) via Resend.
# Copy this file to `.env` (repo root) — the API loads it on startup. Without a
# key the API logs messages to the console instead of sending them, so signup
# and login still work locally. For real sends, set a Resend API key and a
# verified From address (for quick tests, Resend allows onboarding@resend.dev).
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Alojaneo <login@yourdomain.com>

# Payment gateway. Defaults to the built-in mock adapter.
# PAYMENT_PROVIDER=mock
