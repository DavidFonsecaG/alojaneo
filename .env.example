PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel_dev
PGUSER=app_user
PGPASSWORD=app_user_pw
JWT_SECRET=change-me-in-production

# Transactional email (login codes, booking confirmations). Without a key the
# API logs messages to the console instead of sending them.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Alojaneo <login@yourdomain.com>

# Payment gateway. Defaults to the built-in mock adapter.
# PAYMENT_PROVIDER=mock
