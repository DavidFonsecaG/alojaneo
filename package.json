{
  "name": "alojaneo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:api": "pnpm --filter @alojaneo/api dev",
    "dev:web": "pnpm --filter @alojaneo/web dev",
    "dev:booking": "pnpm --filter @alojaneo/booking dev",
    "dev:admin": "pnpm --filter @alojaneo/admin dev",
    "test": "pnpm --filter @alojaneo/api test",
    "db:migrate": "pnpm --filter @alojaneo/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
